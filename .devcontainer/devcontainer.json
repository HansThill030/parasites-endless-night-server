{
  "name": "Parasites Endless Night Server",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "forwardPorts": [25565, 30037],
  "portsAttributes": {
    "25565": { "label": "Minecraft Server", "onAutoForward": "notify" },
    "30037": { "label": "AutoModpack Host", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postStartCommand": "nohup bash scripts/run-all.sh > /tmp/server-startup.log 2>&1 &"
}